---
import { themeConfig } from '@/config'
import { isPostPage } from '@/utils/page'

interface Props {
  date: Date
  updatedDate?: Date
  minutes?: number
}

const { date, updatedDate } = Astro.props
const { dateFormat: format } = themeConfig.global
const isPost = isPostPage(Astro.url.pathname)

// Format date as "Jan 26, 2025"
function formatPostDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}

function formatDate(date: Date, format: 'YYYY-MM-DD' | 'MM-DD-YYYY' | 'DD-MM-YYYY' | 'MONTH DAY YYYY' | 'DAY MONTH YYYY') {
  if (format === 'YYYY-MM-DD') {
    return date.toISOString().split('T')[0]
  }

  const options: Intl.DateTimeFormatOptions = {
    year: 'numeric',
    month: format === 'MONTH DAY YYYY' || format === 'DAY MONTH YYYY' ? 'short' : '2-digit',
    day: format === 'MONTH DAY YYYY' || format === 'DAY MONTH YYYY' ? 'numeric' : '2-digit',
  }

  switch (format) {
    // US date format: 04-13-2025
    case 'MM-DD-YYYY':
      return date.toLocaleDateString('en-US', options).replace(/\//g, '-')

    // European date format: 13-04-2025
    case 'DD-MM-YYYY':
      return date.toLocaleDateString('en-GB', options).replace(/\//g, '-')

    // US month text format: Apr 13 2025
    case 'MONTH DAY YYYY':
      return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      }).replace(',', '')

    // British month text format: 13 Apr 2025
    case 'DAY MONTH YYYY':
      return date.toLocaleDateString('en-GB', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      }).replace(',', '')

    // Default to ISO format
    default:
      return date.toISOString().split('T')[0]
  }
}
---

{isPost ? (
  <!-- Post page format -->
  <div class="flex flex-col gap-1">
    <div>
      <span class="font-medium">Published:</span>
      {' '}
      <time datetime={date.toISOString().split('T')[0]}>
        {formatPostDate(date)}
      </time>
    </div>
    {updatedDate && (
      <div>
        <span class="font-medium">Updated:</span>
        {' '}
        <time datetime={updatedDate.toISOString().split('T')[0]}>
          {formatPostDate(updatedDate)}
        </time>
      </div>
    )}
  </div>
) : (
  <!-- Default format for other pages -->
  <>
    <time datetime={date.toISOString().split('T')[0]}>
      {formatDate(date, format)}
    </time>
    {updatedDate && (
      <time
        datetime={updatedDate.toISOString().split('T')[0]}
        class="ml-1.5"
      >
        updated {formatDate(updatedDate, format)}
      </time>
    )}
  </>
)}
