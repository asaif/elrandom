---
import { getTagPath } from '@/i18n/path'

interface Props {
  tags: string[]
  currentTag?: string
  lang: string
}

const { tags, currentTag = '', lang } = Astro.props;
---

<div class="no-heti book-tags-section">
  {tags.map(tag => (
    <a
      href={getTagPath(tag, lang)}
      class:list={[
        'book-tag-link',
        currentTag === tag ? 'book-tag-link-active' : '',
      ]}
    >
      {tag}
    </a>
  ))}
</div>
