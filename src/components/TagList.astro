---
import { getTagPath } from '@/i18n/path'

interface Props {
  tags: string[]
  currentTag?: string
  lang: string
}

const { tags, currentTag = '', lang } = Astro.props;
---

<div class="no-heti flex flex-wrap gap-x-2 gap-y-2 lg:gap-x-3 lg:gap-y-3">
  {tags.map(tag => (
    <a
      href={getTagPath(tag, lang)}
      class:list={[
        currentTag === tag
          ? 'border-secondary/70 c-primary font-medium ring-0.15 bg-secondary/8'
          : 'ring-0 bg-secondary/4',
          'relative inline-block border border-secondary/20 rounded-full px-2.5 py-0.5 text-3 ring-secondary/70',
          'transition-[colors,box-shadow,background-color] ease-out hover:(border-secondary/70 c-primary font-medium ring-0.15 bg-secondary/8)',
          'lg:(px-3 py-0.6 text-3.2)',
      ]}
    >
      <span class="absolute inset-0 flex items-center justify-center whitespace-nowrap transition-font-weight">
        #{tag}
      </span>
      <span
        class="inline-block font-medium opacity-0"
        aria-hidden="true"
      >
        #{tag}
      </span>
    </a>
  ))}
</div>
