---
import { defaultLocale, moreLocales } from '@/config'
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { ui } from '@/i18n/ui'
import '@/styles/books.css'

export async function getStaticPaths() {
  type PathItem = {
    params: { books: string }
    props: { lang: string }
  }

  const paths: PathItem[] = []

  // Default locale
  paths.push({
    params: { books: 'books/' },
    props: { lang: defaultLocale },
  })

  // More locales
  moreLocales.forEach((lang: string) => {
    paths.push({
      params: { books: `${lang}/books/` },
      props: { lang },
    })
  })

  return paths
}

const { lang } = Astro.props
const currentUI = ui[lang as keyof typeof ui] ?? {}

// Get all books
const allBooks = await getCollection('books')

// Calculate stats
const currentYear = new Date().getFullYear()

const stats = {
  booksRead: allBooks.filter(b => b.data.status === 'finished').length,
  currentlyReading: allBooks.filter(b => b.data.status === 'reading').length,
  pagesThisYear: allBooks.reduce((sum, book) => {
    // For finished books, check if finished this year
    if (book.data.status === 'finished' && book.data.dateFinished) {
      const finishedYear = book.data.dateFinished.getFullYear()
      if (finishedYear === currentYear) {
        return sum + (book.data.totalPages || 0)
      }
    }
    // For currently reading books, count current progress
    else if (book.data.status === 'reading') {
      return sum + (book.data.currentPage || 0)
    }
    return sum
  }, 0),
}
---

<Layout>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-6 font-bold c-primary mb-3 font-navbar lg:text-7">
      {currentUI.books || 'Books'}
    </h1>
    <p class="text-3.6 c-secondary leading-1.5em lg:text-4">
      {currentUI.booksDescription || "Books I've read, currently reading, and want to read"}
    </p>

    <!-- Reading Stats -->
    <div class="mt-4 text-3.2 c-secondary">
      {lang === 'ar' ? (
        <>
          <span class="font-medium">{stats.booksRead}</span> كتاب قرأته هذا العام ·
          <span class="font-medium">{stats.currentlyReading}</span> أقرأ حالياً ·
          <span class="font-medium">{stats.pagesThisYear.toLocaleString()}</span> صفحة
        </>
      ) : (
        <>
          <span class="font-medium">{stats.booksRead}</span> books read this year ·
          <span class="font-medium">{stats.currentlyReading}</span> currently reading ·
          <span class="font-medium">{stats.pagesThisYear.toLocaleString()}</span> pages
        </>
      )}
    </div>
  </div>

  <!-- Status Tabs -->
  <div class="books-status-tabs font-serif" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <button class="books-tab-button active" data-status="reading">
      {lang === 'ar' ? 'أقرأ' : 'READING'}
    </button>
    <button class="books-tab-button" data-status="finished">
      {lang === 'ar' ? 'قرأته' : 'FINISHED'}
    </button>
    <button class="books-tab-button" data-status="want-to-read">
      {lang === 'ar' ? 'أنوي قرائته' : 'WANT TO READ'}
    </button>
  </div>

  <!-- Books List -->
  <div class="books-list-container">
    {allBooks.map((book) => {
      const bookId = book.id.replace('.md', '').replace('.mdx', '')
      const numericRating = book.data.rating ? (book.data.rating.match(/★/g) || []).length : 0

      // Calculate progress percentage from currentPage and totalPages
      const progressPercentage = book.data.currentPage && book.data.totalPages && book.data.totalPages > 0
        ? Math.round((book.data.currentPage / book.data.totalPages) * 100)
        : 0

      return (
        <article class="book-list-card" data-status={book.data.status}>
          <a href={`/book/${bookId}/`} class="book-list-card-link">
            <!-- Book Cover -->
            <div class="book-list-cover-wrapper">
              {book.data.coverImage ? (
                <img src={book.data.coverImage} alt={book.data.title} class="book-list-cover-img" />
              ) : (
                <div class="book-list-cover-placeholder">
                  <span class="book-list-placeholder-text">{book.data.title}</span>
                </div>
              )}
            </div>

            <!-- Book Info -->
            <div class="book-list-info">
              <h3 class="book-list-card-title font-navbar">{book.data.title}</h3>
              <p class="book-list-card-author font-serif">{book.data.author}</p>

              <!-- Progress Bar for Reading -->
              {book.data.status === 'reading' && progressPercentage > 0 && (
                <div class="book-list-progress-section">
                  <div class="book-list-progress-wrapper">
                    <div class="book-list-progress-bg">
                      <div class="book-list-progress-fill" style={`width: ${progressPercentage}%`}></div>
                    </div>
                    <span class="book-list-progress-text">{progressPercentage}%</span>
                  </div>
                </div>
              )}

              <!-- Rating for Finished -->
              {book.data.status === 'finished' && book.data.rating && (
                <div class="book-list-rating-section">
                  <div class="book-list-rating-stars">
                    {[1, 2, 3, 4, 5].map((star) => (
                      <span class={star <= numericRating ? 'book-list-star-filled' : 'book-list-star-empty'}>★</span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </a>
        </article>
      )
    })}
  </div>

  <script is:inline>
    // Tab functionality - using is:inline to ensure it runs on every page load
    (function() {
      function initTabs() {
        const tabs = document.querySelectorAll('.books-tab-button')
        const books = document.querySelectorAll('.book-list-card')

        if (tabs.length === 0 || books.length === 0) return

        // Remove existing event listeners by cloning nodes
        tabs.forEach(function(tab) {
          var newTab = tab.cloneNode(true)
          tab.parentNode.replaceChild(newTab, tab)
        })

        // Get fresh references after cloning
        const freshTabs = document.querySelectorAll('.books-tab-button')

        // Add event listeners to fresh tabs
        freshTabs.forEach(function(tab) {
          tab.addEventListener('click', function(e) {
            e.preventDefault()
            const status = tab.getAttribute('data-status')

            // Update active tab
            freshTabs.forEach(function(t) {
              t.classList.remove('active')
            })
            tab.classList.add('active')

            // Show/hide books based on status
            books.forEach(function(book) {
              if (book.getAttribute('data-status') === status) {
                book.style.display = 'flex'
              } else {
                book.style.display = 'none'
              }
            })
          })
        })
      }

      // Run on initial page load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTabs)
      } else {
        initTabs()
      }

      // Re-run on Astro page navigation (view transitions)
      document.addEventListener('astro:page-load', initTabs)
    })()
  </script>
</Layout>
