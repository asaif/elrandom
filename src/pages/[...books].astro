---
import { defaultLocale, moreLocales } from '@/config'
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { ui } from '@/i18n/ui'

export async function getStaticPaths() {
  type PathItem = {
    params: { books: string }
    props: { lang: string }
  }

  const paths: PathItem[] = []

  // Default locale
  paths.push({
    params: { books: 'books/' },
    props: { lang: defaultLocale },
  })

  // More locales
  moreLocales.forEach((lang: string) => {
    paths.push({
      params: { books: `${lang}/books/` },
      props: { lang },
    })
  })

  return paths
}

const { lang } = Astro.props
const currentUI = ui[lang as keyof typeof ui] ?? {}

// Get all books
const allBooks = await getCollection('books')

// Sort by date (most recent first)
const sortedBooks = allBooks.sort((a, b) => {
  const dateA = a.data.dateFinished || a.data.dateStarted || a.data.dateAdded
  const dateB = b.data.dateFinished || b.data.dateStarted || b.data.dateAdded
  return dateB.getTime() - dateA.getTime()
})

// Group by year
const booksByYear = sortedBooks.reduce((acc, book) => {
  const year = book.data.year
  if (!acc[year]) {
    acc[year] = []
  }
  acc[year].push(book)
  return acc
}, {} as Record<number, typeof sortedBooks>)

// Calculate stats
const currentYear = new Date().getFullYear()

// Debug logging
console.log('Current year:', currentYear)
console.log('All books:', allBooks.map(b => ({
  title: b.data.title,
  year: b.data.year,
  status: b.data.status,
  totalPages: b.data.totalPages,
  currentPage: b.data.currentPage
})))

const stats = {
  booksRead: allBooks.filter(b => b.data.status === 'finished').length,
  currentlyReading: allBooks.filter(b => b.data.status === 'reading').length,
  pagesThisYear: allBooks
    .filter(b => b.data.year === currentYear)
    .reduce((sum, book) => {
      console.log('Processing book:', book.data.title, 'status:', book.data.status, 'totalPages:', book.data.totalPages, 'currentPage:', book.data.currentPage)
      if (book.data.status === 'finished') {
        return sum + (book.data.totalPages || 0)
      } else if (book.data.status === 'reading') {
        return sum + (book.data.currentPage || 0)
      }
      return sum
    }, 0),
}

console.log('Stats:', stats)

// Format date helper
function formatDate(date: Date): string {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  const month = months[date.getMonth()]
  const day = String(date.getDate()).padStart(2, '0')
  const year = date.getFullYear()
  return `${month} ${day}, ${year}`
}

// Calculate reading time helper
function getReadingTime(startDate?: Date, endDate?: Date): string {
  if (!startDate) return ''
  const end = endDate || new Date()
  const days = Math.floor((end.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24))
  if (days === 0) return 'Started today'
  if (days === 1) return '1 day'
  return `${days} days`
}
---

<Layout>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-6 font-bold c-primary mb-3 font-navbar lg:text-7">
      {currentUI.books || 'Books'}
    </h1>
    <p class="text-3.6 c-secondary leading-1.5em lg:text-4">
      {currentUI.booksDescription || "Books I've read, currently reading, and want to read"}
    </p>

    <!-- Reading Stats -->
    <div class="mt-4 text-3.2 c-secondary">
      <span class="font-medium">{stats.booksRead}</span> books read this year ·
      <span class="font-medium">{stats.currentlyReading}</span> currently reading ·
      <span class="font-medium">{stats.pagesThisYear.toLocaleString()}</span> pages
    </div>
  </div>

  <div class="reading-page">

    <!-- Books by Year -->
    {Object.entries(booksByYear).sort(([a], [b]) => Number(b) - Number(a)).map(([year, books]) => (
      <section class="year-section">
        <h2 class="year-title">{year}</h2>

        <div class="books-list">
          {books.map(async (book) => {
            const { Content } = await render(book)
            const date = book.data.dateFinished || book.data.dateStarted || book.data.dateAdded
            const readingTime = getReadingTime(book.data.dateStarted, book.data.dateFinished)

            return (
              <article
                class={`book-entry ${book.data.language === 'ar' ? 'rtl' : ''}`}
              >
                <!-- Date and Status -->
                <div class="book-date">
                  {formatDate(date)}
                  {readingTime && ` · ${readingTime}`}
                </div>
                <div class="book-status-badge">
                  {book.data.status.replace('-', ' ')}
                </div>

                <!-- Title and Author -->
                <div class="book-header">
                  <a href={`/book/${book.id.replace('.md', '').replace('.mdx', '')}/`} class="book-title-link">
                    <h3 class="book-title hover:c-primary transition-colors">{book.data.title}</h3>
                  </a>
                  <p class="book-author">{book.data.author}</p>
                </div>

                <!-- Progress Bar for Currently Reading -->
                {book.data.status === 'reading' && book.data.progress && (
                  <div class="book-progress">
                    {book.data.progress}% · page {book.data.currentPage} of {book.data.totalPages}
                    <div class="progress-bar">
                      <div
                        class="progress-fill"
                        style={`width: ${book.data.progress}%`}
                      />
                    </div>
                  </div>
                )}

                <!-- Rating -->
                {book.data.rating && (
                  <div class="book-rating">
                    {book.data.rating}
                  </div>
                )}

                <!-- Book Content/Review -->
                <div class="book-content">
                  <Content />
                </div>

                <!-- Quote -->
                {book.data.quote && (
                  <div class="book-quote">
                    "{book.data.quote}"
                  </div>
                )}

                <!-- Tags -->
                {book.data.tags && book.data.tags.length > 0 && (
                  <div class="flex gap-1 flex-wrap mt-4">
                    {book.data.tags.map(tag => (
                      <a
                        href={`/${lang === defaultLocale ? '' : lang + '/'}tags/${tag}/`}
                        class="inline-block px-2 py-0.4 text-2.2 leading-none c-secondary/50 bg-secondary/4 rounded-full hover:c-secondary/70 hover:bg-secondary/8 transition-all duration-200 ease-out text-decoration-none whitespace-nowrap"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )}
              </article>
            )
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .reading-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 40px 100px;
  }

  /* Reading Stats - Minimal */
  .reading-stats {
    text-align: left;
    margin-bottom: 60px;
    padding-bottom: 40px;
    border-bottom: 1px solid #f0f0f0;
  }

  .stats-line {
    font-size: 15px;
    color: #999;
    font-style: italic;
    margin-bottom: 8px;
  }

  .stats-line strong {
    color: var(--c-primary, #8b2942);
    font-weight: normal;
  }

  /* Year Section */
  .year-section {
    margin-bottom: 60px;
  }

  .year-title {
    font-size: 36px;
    font-style: italic;
    color: var(--c-primary, #8b2942);
    margin-bottom: 40px;
    text-align: left;
  }

  /* Book Entry - Minimal Timeline */
  .books-list {
    position: relative;
  }

  .book-entry {
    margin-bottom: 60px;
    padding-left: 60px;
    position: relative;
  }

  /* Timeline dot */
  .book-entry::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--c-primary, #8b2942);
    border-radius: 50%;
  }

  /* Connecting line between books */
  .book-entry:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 11px;
    top: 16px;
    width: 1px;
    height: calc(100% + 44px);
    background: #e5e5e5;
    z-index: -1;
  }

  .book-date {
    font-size: 13px;
    color: #bbb;
    font-style: italic;
    position: absolute;
    left: -165px;
    top: 6px;
    width: 150px;
    text-align: right;
  }

  .book-status-badge {
    font-size: 11px;
    color: #999;
    position: absolute;
    left: -165px;
    top: 26px;
    width: 150px;
    text-align: right;
  }

  .book-header {
    margin-bottom: 16px;
  }

  .book-title-link {
    text-decoration: none;
    color: inherit;
  }

  .book-title {
    font-size: 28px;
    color: #333;
    font-weight: normal;
    margin-bottom: 6px;
    line-height: 1.3;
    cursor: pointer;
  }

  .book-author {
    font-size: 16px;
    color: #999;
    font-style: italic;
  }

  /* Progress for currently reading */
  .book-progress {
    font-size: 14px;
    color: var(--c-primary, #8b2942);
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .progress-bar {
    width: 200px;
    height: 2px;
    background: #f0f0f0;
    margin-top: 6px;
    position: relative;
  }

  .progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background: var(--c-primary, #8b2942);
  }

  /* Rating */
  .book-rating {
    color: var(--c-primary, #8b2942);
    font-size: 14px;
    margin-bottom: 16px;
  }

  /* Review/Thoughts */
  .book-content {
    font-size: 16px;
    color: #666;
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .book-content :global(p) {
    margin-bottom: 16px;
  }

  .book-content :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Quote */
  .book-quote {
    margin-top: 20px;
    padding-left: 20px;
    border-left: 2px solid #e5e5e5;
    font-style: italic;
    color: #888;
    line-height: 1.8;
  }

  /* RTL Support */
  .book-entry.rtl {
    direction: rtl;
    text-align: right;
    padding-left: 0;
    padding-right: 60px;
  }

  .book-entry.rtl::before {
    left: auto;
    right: 8px;
  }

  .book-entry.rtl:not(:last-child)::after {
    left: auto;
    right: 11px;
  }

  .book-entry.rtl .book-date,
  .book-entry.rtl .book-status-badge {
    left: auto;
    right: -165px;
    text-align: left;
  }

  .book-entry.rtl .book-quote {
    padding-left: 0;
    padding-right: 20px;
    border-left: none;
    border-right: 2px solid #e5e5e5;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .reading-page {
      padding: 40px 20px 60px;
    }

    .book-entry {
      padding-left: 40px;
    }

    .book-entry::after {
      left: 11px;
    }

    .book-date,
    .book-status-badge {
      position: static;
      text-align: left;
      width: auto;
      margin-bottom: 8px;
    }

    .book-entry.rtl {
      padding-right: 40px;
    }

    .book-entry.rtl .book-date,
    .book-entry.rtl .book-status-badge {
      text-align: right;
    }

    .year-title {
      font-size: 28px;
    }

    .book-title {
      font-size: 24px;
    }
  }
</style>
