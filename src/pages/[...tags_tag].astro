---
import { defaultLocale, moreLocales } from '@/config'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'
import { getPostPath, getTagPath } from '@/i18n/path'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  type PathItem = {
    params: { tags_tag: string }
    props: { tag: string, lang: string }
  }

  const paths: PathItem[] = []

  // Default locale
  const defaultTags = await getAllTags(defaultLocale)
  defaultTags.forEach((tag: string) => {
    paths.push({
      params: { tags_tag: `tags/${tag}/` },
      props: { tag, lang: defaultLocale },
    })
  })

  // More locales
  for (const lang of moreLocales) {
    const langTags = await getAllTags(lang)
    langTags.forEach((tag: string) => {
      paths.push({
        params: { tags_tag: `${lang}/tags/${tag}/` },
        props: { tag, lang },
      })
    })
  }

  return paths
}

const { tag, lang } = Astro.props
const items = await getPostsByTag(tag, lang)
const supportedLangs = await getTagSupportedLangs(tag)

// Separate posts and books with proper type guards
const posts = items.filter(item => 'published' in item.data)
const books = items.filter(item => 'dateAdded' in item.data) as unknown as CollectionEntry<'books'>[]

// Group posts by year
const postsByYear = new Map<number, typeof posts>()
posts.forEach(post => {
  const year = post.data.published.getFullYear()
  if (!postsByYear.has(year)) {
    postsByYear.set(year, [])
  }
  postsByYear.get(year)!.push(post)
})

// Group books by year
const booksByYear = new Map<number, typeof books>()
books.forEach(book => {
  const year = book.data.year
  if (!booksByYear.has(year)) {
    booksByYear.set(year, [])
  }
  booksByYear.get(year)!.push(book)
})

// Sort years in descending order and sort posts within each year
const sortedYears = Array.from(postsByYear.keys()).sort((a, b) => b - a)
sortedYears.forEach(year => {
  postsByYear.get(year)!.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
})

// Format date function for MM-DD
function formatDate(date: Date): string {
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  return `${month}-${day}`
}

// Get all years as array for easier indexing
const yearsArray = sortedYears.map(year => [year, postsByYear.get(year)!] as const)
---

<Layout supportedLangs={supportedLangs}>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />

  <!-- Tag Header -->
  <div class="mb-10">
    <h1 class="text-6 font-bold c-primary mb-3 font-navbar lg:text-7">
      {tag}
    </h1>
    <p class="text-3.6 c-secondary leading-1.5em lg:text-4">
      Posts and books related to {tag}
    </p>

    <!-- Total Count -->
    <div class="mt-4 text-3.2 c-secondary">
      <span class="font-medium">{items.length}</span> {items.length === 1 ? 'item' : 'items'}
      {posts.length > 0 && books.length > 0 && (
        <span> · <span class="font-medium">{posts.length}</span> {posts.length === 1 ? 'post' : 'posts'} · <span class="font-medium">{books.length}</span> {books.length === 1 ? 'book' : 'books'}</span>
      )}
    </div>
  </div>

  <!-- Posts List Grouped by Year with Timeline -->
  {posts.length > 0 ? (
    <div class="mt-10.5">
      {yearsArray.map(([year, posts], yearIndex) => (
        <div class="relative">
          <!-- Year Timeline Item -->
          <div class="flex items-center h-12 mb-2">
            <!-- Year -->
            <div class="w-16 text-right pr-4">
              <h2 class="text-4.5 font-bold c-primary font-navbar">
                {year}
              </h2>
            </div>
            
            <!-- Timeline Column -->
            <div class="relative w-4 h-full flex items-center justify-center">
              <!-- Year Circle -->
              <div class="w-2 h-2 rounded-full bg-primary relative z-10"></div>
              <!-- Line starts AFTER the circle and continues to next section -->
              {(posts.length > 0 || yearIndex < yearsArray.length - 1) && (
                <div class="absolute w-px timeline-line-year left-1/2 transform -translate-x-1/2 timeline-line"></div>
              )}
            </div>
            
            <!-- Empty space to maintain layout -->
            <div class="pl-4">
              <!-- Empty for tag page -->
            </div>
          </div>
          
          <!-- Posts for this year -->
          {posts.map((post, postIndex) => {
            const slug = post.data.abbrlink || post.id
            const postPath = getPostPath(slug, lang)
            
            return (
              <div class="flex mb-1 group">
                <!-- Date -->
                <div class="w-16 text-right pr-4 pt-0.5">
                  <time
                    class="text-3.2 c-secondary font-time"
                    datetime={post.data.published.toISOString()}
                  >
                    {formatDate(post.data.published)}
                  </time>
                </div>

                <!-- Timeline Column -->
                <div class="relative w-4 flex justify-center pt-1.5">
                  <!-- Line continues through all items except the very last one -->
                  {!(postIndex === posts.length - 1 && yearIndex === yearsArray.length - 1) && (
                    <div class="absolute w-px timeline-line-post left-1/2 transform -translate-x-1/2 top-0 timeline-line"></div>
                  )}
                  <!-- Post Dot -->
                  <div class="w-2 h-2 rounded-full bg-primary relative z-10"></div>
                </div>

                <!-- Post Content -->
                <div class="flex-1 pl-4">
                  <a
                    href={postPath}
                    class="text-decoration-none"
                  >
                    <h3
                      class="cjk:tracking-0.02em text-3.8 leading-1.4em transition-colors hover:c-primary group-hover:c-primary"
                      transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
                      data-disable-theme-transition
                    >
                      {post.data.title}
                    </h3>
                  </a>

                  <!-- Tags -->
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="book-tags-section-compact">
                      {post.data.tags.map(postTag => (
                        <a
                          href={getTagPath(postTag, lang)}
                          class="book-tag-link"
                        >
                          {postTag}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )
          })}
          
          <!-- Add spacing between years -->
          {yearIndex < yearsArray.length - 1 && (
            <div class="h-6"></div>
          )}
        </div>
      ))}
    </div>
  ) : null}

  <!-- Books Section -->
  {books.length > 0 && (
    <div class:list={[posts.length > 0 ? 'mt-16' : 'mt-10.5']}>
      <h2 class="text-5 font-bold c-primary font-navbar mb-6">Books</h2>
      {Array.from(booksByYear.keys()).sort((a, b) => b - a).map((year) => {
        const yearBooks = booksByYear.get(year)!
        return (
          <div class="mb-8">
            <h3 class="text-4.5 font-bold c-primary font-navbar mb-4">{year}</h3>
            <div class="space-y-4">
              {yearBooks.map((book) => {
                const bookId = book.id.replace('.md', '').replace('.mdx', '')
                return (
                  <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-2 h-2 rounded-full bg-primary mt-2"></div>
                    <div class="flex-1">
                      <a
                        href={`/${lang === defaultLocale ? '' : lang + '/'}book/${bookId}/`}
                        class="text-decoration-none"
                      >
                        <h4 class="text-3.8 c-primary font-navbar mb-1 hover:underline transition-all">{book.data.title}</h4>
                      </a>
                      <p class="text-3.4 c-secondary/70 italic mb-1">{book.data.author}</p>
                      {book.data.rating && (
                        <div class="text-3.2 c-primary mb-2">{book.data.rating}</div>
                      )}
                      <div class="book-tags-section-compact">
                        {book.data.tags?.map(bookTag => (
                          <a
                            href={`/${lang === defaultLocale ? '' : lang + '/'}tags/${bookTag}/`}
                            class="book-tag-link"
                          >
                            {bookTag}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        )
      })}
    </div>
  )}

  {posts.length === 0 && books.length === 0 && (
    <!-- Empty State -->
    <div class="mt-10.5 text-center py-8">
      <p class="text-3.6 c-secondary">No content found with this tag.</p>
    </div>
  )}
</Layout>

<style>
  .timeline-line-year {
    top: 50%;
    bottom: -5px;
  }
  
  .timeline-line-post {
    height: 104%;
  }
  
  .timeline-line {
    background: #e5e5e5;
  }
  
  html.dark .timeline-line {
    background: oklch(40% 0.005 298 / 0.2);
  }
</style>