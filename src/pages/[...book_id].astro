---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { defaultLocale, moreLocales } from '@/config'

export async function getStaticPaths() {
  const books = await getCollection('books')
  const paths: any[] = []

  books.forEach(book => {
    const bookId = book.id.replace('.md', '').replace('.mdx', '')

    // Generate path for default language
    paths.push({
      params: { book_id: `book/${bookId}/` },
      props: { book, lang: defaultLocale },
    })

    // Generate paths for other languages
    moreLocales.forEach(locale => {
      paths.push({
        params: { book_id: `${locale}/book/${bookId}/` },
        props: { book, lang: locale },
      })
    })
  })

  return paths
}

const { book, lang } = Astro.props
const { Content } = await render(book)

// Calculate reading time
function getReadingTime(startDate?: Date, endDate?: Date): string {
  if (!startDate) return ''
  const end = endDate || new Date()
  const days = Math.floor((end.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24))
  if (days === 0) return 'Started today'
  if (days === 1) return '1 day'
  return `${days} days`
}

// Format date
function formatDate(date: Date): string {
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  const month = months[date.getMonth()]
  const day = String(date.getDate()).padStart(2, '0')
  const year = date.getFullYear()
  return `${month} ${day}, ${year}`
}

// Get numeric rating from star string
function getNumericRating(rating: string): number {
  return (rating.match(/★/g) || []).length
}

const readingTime = getReadingTime(book.data.dateStarted, book.data.dateFinished)
const displayDate = book.data.dateFinished || book.data.dateStarted || book.data.dateAdded
const pagesRemaining = book.data.totalPages && book.data.currentPage
  ? book.data.totalPages - book.data.currentPage
  : 0
const numericRating = book.data.rating ? getNumericRating(book.data.rating) : 0

// Calculate progress percentage from currentPage and totalPages
const calculateProgress = (): number => {
  if (book.data.currentPage && book.data.totalPages && book.data.totalPages > 0) {
    return Math.round((book.data.currentPage / book.data.totalPages) * 100)
  }
  return 0
}
const progressPercentage = calculateProgress()
---

<Layout>
  <div class="book-detail-container" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <!-- Back Link -->
    <a href="/books/" class="book-back-link font-serif">
      ← {lang === 'ar' ? 'العودة إلى الكتب' : 'Back to Reading'}
    </a>

    <!-- Book Header with Cover -->
    <div class="book-header-grid">
      <div class="book-detail-cover-container">
        {book.data.coverImage ? (
          <div class="book-detail-cover">
            <img src={book.data.coverImage} alt={book.data.title} />
          </div>
        ) : (
          <div class="book-detail-cover book-detail-cover-placeholder">
            <span>{book.data.title}</span>
          </div>
        )}
      </div>

      <div class="book-detail-info">
        <h1 class="book-detail-title font-navbar">{book.data.title}</h1>
        <p class="book-detail-author font-serif">{book.data.author}</p>

        <div class="book-meta-grid font-serif">
          <div class="book-meta-item">
            <div class="book-meta-label">{lang === 'ar' ? 'الحالة' : 'Status'}</div>
            <div class={`book-meta-value status-${book.data.status}`}>
              {lang === 'ar'
                ? (book.data.status === 'reading' ? 'أقرأ' :
                   book.data.status === 'finished' ? 'قرأته' :
                   'أنوي قرائته')
                : book.data.status.replace('-', ' ')}
            </div>
          </div>
          {book.data.totalPages && (
            <div class="book-meta-item">
              <div class="book-meta-label">{lang === 'ar' ? 'الصفحات' : 'Pages'}</div>
              <div class="book-meta-value">{book.data.totalPages}</div>
            </div>
          )}
          {displayDate && (
            <div class="book-meta-item">
              <div class="book-meta-label">
                {lang === 'ar'
                  ? (book.data.status === 'finished' ? 'انتهى في' : 'بدأت في')
                  : (book.data.status === 'finished' ? 'Finished' : 'Started')}
              </div>
              <div class="book-meta-value">
                {formatDate(displayDate)}
              </div>
            </div>
          )}
          {book.data.status === 'finished' && readingTime && (
            <div class="book-meta-item">
              <div class="book-meta-label">{lang === 'ar' ? 'قرأت في' : 'Read in'}</div>
              <div class="book-meta-value">{readingTime}</div>
            </div>
          )}
          {book.data.genre && (
            <div class="book-meta-item">
              <div class="book-meta-label">{lang === 'ar' ? 'النوع' : 'Genre'}</div>
              <div class="book-meta-value">{book.data.genre}</div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Reading Progress -->
    {book.data.status === 'reading' && progressPercentage > 0 && (
      <div class="book-detail-progress-section">
        <div class="book-detail-progress-header">
          <h2 class="book-detail-progress-title font-navbar">{lang === 'ar' ? 'تقدم القراءة' : 'Reading Progress'}</h2>
          <div class="book-detail-progress-percentage font-serif">{progressPercentage}%</div>
        </div>
        <div class="book-detail-progress-bar-container">
          <div class="book-detail-progress-bar-fill" style={`width: ${progressPercentage}%`}></div>
        </div>
        <div class="book-detail-progress-detail font-serif">
          {lang === 'ar'
            ? `صفحة ${book.data.currentPage} من ${book.data.totalPages}${pagesRemaining > 0 ? ` · ${pagesRemaining} صفحات متبقية` : ''}`
            : `Page ${book.data.currentPage} of ${book.data.totalPages}${pagesRemaining > 0 ? ` · ${pagesRemaining} pages remaining` : ''}`}
        </div>
      </div>
    )}

    <!-- Rating -->
    {book.data.status === 'finished' && book.data.rating && (
      <div class="book-detail-rating-section">
        <div class="book-detail-rating-stars">
          {[1, 2, 3, 4, 5].map((star) => (
            <span class={star <= numericRating ? 'star filled' : 'star empty'}>★</span>
          ))}
        </div>
        <div class="book-detail-rating-label font-serif">{lang === 'ar' ? 'تقييمي' : 'My Rating'}</div>
        {book.data.dateFinished && (
          <div class="book-detail-rating-date font-serif">
            {lang === 'ar' ? `انتهى في ${formatDate(book.data.dateFinished)}` : `Finished ${formatDate(book.data.dateFinished)}`}
          </div>
        )}
      </div>
    )}

    <!-- My Thoughts -->
    <h2 class="book-section-title font-navbar">
      {lang === 'ar'
        ? (book.data.status === 'reading' ? 'أفكاري حتى الآن' :
           book.data.status === 'finished' ? 'مراجعتي' :
           'لماذا أريد قراءة هذا')
        : (book.data.status === 'reading' ? 'My Thoughts So Far' :
           book.data.status === 'finished' ? 'My Review' :
           'Why I Want to Read This')}
    </h2>
    <div class="book-review-content heti font-serif">
      <Content />
    </div>

    <!-- Quotes -->
    {book.data.quote && (
      <>
        <h2 class="book-section-title font-navbar">
          {lang === 'ar'
            ? (book.data.quotes?.length ? 'اقتباساتي المفضلة' : 'اقتباسي المفضل')
            : `Favorite Quote${book.data.quotes?.length ? 's' : ''}`}
        </h2>
        <div class="book-quotes-section font-serif">
          <div class="book-quote-item">"{book.data.quote}"</div>
          {book.data.quotes?.map((quote: string) => (
            <div class="book-quote-item">"{quote}"</div>
          ))}
        </div>
      </>
    )}

    <!-- Timeline -->
    {book.data.timeline && book.data.timeline.length > 0 && (
      <>
        <h2 class="book-section-title font-navbar">{lang === 'ar' ? 'الجدول الزمني للقراءة' : 'Reading Timeline'}</h2>
        <div class="book-timeline-section font-serif">
          {book.data.timeline.map((entry: { date: Date; note: string }, index: number) => (
            <div class="book-timeline-item">
              <!-- Timeline Column with Dot and Line -->
              <div class="book-timeline-column">
                <div class="book-timeline-dot"></div>
                {index < book.data.timeline!.length - 1 && (
                  <div class="book-timeline-line"></div>
                )}
              </div>

              <!-- Timeline Content -->
              <div class="book-timeline-content">
                <div class="book-timeline-date">{formatDate(entry.date)}</div>
                <div class="book-timeline-note">{entry.note}</div>
              </div>
            </div>
          ))}
        </div>
      </>
    )}

    <!-- Tags -->
    {book.data.tags && book.data.tags.length > 0 && (
      <>
        <h2 class="book-section-title font-navbar">{lang === 'ar' ? 'الوسوم والفئات' : 'Tags & Categories'}</h2>
        <div class="book-tags-section font-serif">
          {book.data.tags.map((tag: string) => (
            <a
              href={`/tags/${tag}/`}
              class="book-tag-link"
            >
              {tag}
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</Layout>
